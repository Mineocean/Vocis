# Vocis（声幕）— 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ── API Key ──────────────────────────────────────────
# MiMo ASR（语音识别）
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# DeepSeek（翻译）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── ASR 后端选择 ────────────────────────────────────
# mimo   = MiMo 云端 API（需 MIMO_API_KEY）
# whisper = 本地 Whisper 模型（需 pip install faster-whisper）
# mock    = 模拟文本，仅测试翻译链路
ASR_BACKEND=mimo
WHISPER_MODEL=tiny

# ── 语言 ────────────────────────────────────────────
SOURCE_LANGUAGE=auto
TARGET_LANGUAGE=中文

# ── 显示 ────────────────────────────────────────────
FONT_SIZE=16
SUBTITLE_DURATION=5000
SUBTITLE_POSITION=bottom
SUBTITLE_SCREEN=0

# ── 音频 ────────────────────────────────────────────
AUDIO_DEVICE=auto

# ── 高级选项 ────────────────────────────────────────
CACHE_WINDOW_SECONDS=30
