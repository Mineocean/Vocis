# Vocis（声幕）— 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ── API Key ──────────────────────────────────────────
# MiMo ASR（语音识别）
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# DeepSeek（翻译）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── ASR 后端选择 ────────────────────────────────────
# mimo   = MiMo 云端 API（需 MIMO_API_KEY）
# whisper = 本地 faster-whisper 模型（离线，多语言；模型放在 WHISPER_MODEL_PATH 目录）
# sherpa  = 本地 sherpa-onnx 流式模型（离线，中文实时，最快；模型在 SHERPA_MODEL_PATH）
# mock    = 模拟文本，仅测试翻译链路
ASR_BACKEND=sherpa
WHISPER_MODEL=base
# 本地 whisper 模型目录（包含 model.bin / config.json / tokenizer.json 等文件）
# 首次使用可从 huggingface.co/Systran/faster-whisper-base 下载
WHISPER_MODEL_PATH=models/faster-whisper-base
# sherpa-onnx 流式中文模型目录（encoder/decoder/joiner int8 onnx + tokens.txt）
# 首次使用可从 github.com/k2-fsa/sherpa-onnx 的 asr-models release 下载
SHERPA_MODEL_PATH=models/sherpa-streaming-zh-14M
# 源语言 == 目标语言时跳过翻译（如中文音频 + 中文目标，直接显示原文）
SKIP_TRANSLATE_SAME_LANG=true
WHISPER_DEVICE=auto

# ── 语言 ────────────────────────────────────────────
SOURCE_LANGUAGE=auto
TARGET_LANGUAGE=中文

# ── 显示 ────────────────────────────────────────────
FONT_SIZE=16
SUBTITLE_DURATION=5000
SUBTITLE_POSITION=bottom
SUBTITLE_SCREEN=0

# ── 音频 ────────────────────────────────────────────
AUDIO_DEVICE=auto

# ── 高级选项 ────────────────────────────────────────
CACHE_WINDOW_SECONDS=30
