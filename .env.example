# Vocis（声幕）— 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ── 翻译提供商（任意 OpenAI 兼容 /chat/completions 端点）────────────
# deepseek | openai | moonshot | qwen | zhipu | groq | siliconflow | ollama | custom
# 换提供商只需要改这三行；Base URL / 默认模型会按预设自动填充
TRANSLATOR_PROVIDER=deepseek
TRANSLATOR_API_KEY=your_key_here
TRANSLATOR_BASE_URL=
TRANSLATOR_MODEL=
# 可选：TRANSLATOR_TEMPERATURE=0.1 / TRANSLATOR_MAX_TOKENS=512
TARGET_LANGUAGE=中文

# 兼容旧版 .env：DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL 仍会被读取

# ── ASR 后端 ────────────────────────────────────────────────────────
# mimo              = MiMo 云端（私有 chat 协议，需 MIMO_API_KEY）
# openai/groq/...   = OpenAI 兼容 /audio/transcriptions（用 ASR_API_KEY/ASR_BASE_URL/ASR_MODEL）
# whisper           = 本地 faster-whisper（离线多语言，模型在 WHISPER_MODEL_PATH）
# sherpa            = 本地 sherpa-onnx 流式中文（最快，模型在 SHERPA_MODEL_PATH）
# mock              = 模拟文本，仅测试链路
ASR_BACKEND=sherpa
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=

WHISPER_MODEL=base
WHISPER_DEVICE=auto
# 本地 whisper 模型目录（model.bin / config.json / tokenizer.json 等）
WHISPER_MODEL_PATH=models/faster-whisper-base
# sherpa-onnx 流式中文模型目录（encoder/decoder/joiner int8 onnx + tokens.txt）
SHERPA_MODEL_PATH=models/sherpa-streaming-zh-14M
# 源语言 == 目标语言时跳过翻译（如中文音频 + 中文目标，直接显示原文）
SKIP_TRANSLATE_SAME_LANG=true
SOURCE_LANGUAGE=auto

# MiMo 旧版变量（ASR_BACKEND=mimo 时生效）
# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_ASR_MODEL=mimo-v2.5-asr

# ── 说话人分离（字幕带「说话人 1/2/3」标签）────────────────────────
# sherpa  = CAM++ 神经说话人嵌入（推荐；首次启用时自动下载约 27MB 模型）
# cluster = 零下载 MFCC 统计聚类（精度较低，应急用）
DIARIZATION_ENABLED=false
DIARIZATION_BACKEND=sherpa
DIARIZATION_MAX_SPEAKERS=4
# 余弦相似度阈值：留空 = 后端实测默认（sherpa 0.55 / cluster 0.80）
DIARIZATION_THRESHOLD=
# 自定义说话人嵌入模型路径（留空自动查找/下载）
DIARIZATION_MODEL_PATH=

# ── 显示 ────────────────────────────────────────────────────────────
FONT_SIZE=16
SUBTITLE_DURATION=5000
SUBTITLE_POSITION=bottom
SUBTITLE_SCREEN=0
STREAM_TRANSLATION=true
SPEAKER_COLORS=true
UI_LANGUAGE=

# ── 音频 ────────────────────────────────────────────────────────────
AUDIO_DEVICE=auto

# ── 高级选项 ────────────────────────────────────────────────────────
CACHE_WINDOW_SECONDS=30
# 增量实时识别
INCREMENTAL_ENABLED=true
INCREMENTAL_INTERVAL=1.2
INCREMENTAL_MAX_SECONDS=5.0
STREAM_SENTENCE_CHARS=12
